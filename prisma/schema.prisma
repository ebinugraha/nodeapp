generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @db.VarChar(36)
  name          String       @db.VarChar(60)
  email         String       @unique @db.VarChar(254)
  emailVerified Boolean      @default(false)
  image         String?      @db.VarChar(500)
  bio           String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  credentials   Credential[]
  accounts      Account[]
  sessions      Session[]
  workflows     Workflow[]
  settings      Settings?
  templates     Template[]
  plan          String       @default("FREE")
  planExpiresAt DateTime?

  @@map("user")
}

model Settings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           String   @default("system")
  showLineNumbers Boolean  @default(true)
  snapToGrid      Boolean  @default(true)
  compactMode     Boolean  @default(false)
  showMiniMap     Boolean  @default(true)
  emailExecution  Boolean  @default(false)
  emailError      Boolean  @default(true)
  emailCredential Boolean  @default(true)
  browserNotif    Boolean  @default(true)
  browserSound    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@map("settings")
}

model Session {
  id        String   @id @db.VarChar(36)
  expiresAt DateTime
  token     String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  nodeType    NodeType
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nodeType])
  @@map("template")
}

model Workflow {
  id          String       @id @default(cuid()) @db.VarChar(36)
  name        String       @db.VarChar(70)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  userId      String
  executions  Execution[]
  connections Connection[]
  nodes       Node[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workflow")
}

model Credential {
  id                String         @id @default(cuid()) @db.VarChar(36)
  name              String         @db.VarChar(100)
  value             String         @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  type              CredentialType
  userId            String
  dailyQuotaLimit   Int?
  dailyQuotaUsed    Int            @default(0)
  lastQuotaReset    DateTime       @default(now())
  monthlyQuotaLimit Int?
  monthlyQuotaUsed  Int            @default(0)
  lastMonthlyReset  DateTime       @default(now())
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  Node              Node[]

  @@map("Credential")
}

model Node {
  id                String       @id @default(cuid()) @db.VarChar(36)
  workflowId        String
  name              String
  type              NodeType
  position          Json
  data              Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  credentialId      String?
  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")
  credential        Credential?  @relation(fields: [credentialId], references: [id])
  workflow          Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("node")
}

model Connection {
  id         String   @id @default(cuid()) @db.VarChar(36)
  workflowId String
  fromNodeId String
  toNodeId   String
  fromOutput String   @default("main")
  toInput    String   @default("main")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  fromNode   Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
  @@map("connection")
}

model Execution {
  id             String          @id @default(cuid()) @db.VarChar(36)
  workflowId     String
  status         ExecutionStatus @default(RUNNING)
  error          String?
  errorStack     String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  inngestEventId String          @unique
  output         Json?
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

enum CredentialType {
  YOUTUBE
  GOOGLE
}

enum NodeType {
  INTITAL
  MANUAL_TRIGGER
  HTTP_REQUEST
  DISCORD_NOTIFY
  SLACK
  YOUTUBE_LIVE_CHAT
  YOUTUBE_DELETE_CHAT
  YOUTUBE_VIDEO_COMMENT
  YOUTUBE_REPLY
  YOUTUBE_TIMEOUT
  YOUTUBE_PIN
  GOOGLE_SHEETS
  DECISION
  WAIT_DELAY
  WEBHOOK
  EMAIL_NOTIFY
  LOOP
  ROUTER
  GAMBLING_CHECKER
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}
